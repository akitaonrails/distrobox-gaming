#!/usr/bin/env sh
set -eu
# Sonic XG launcher — official native Linux AppImage (GameMaker) on the RTX,
# DP-1, presented fullscreen by gamescope (integer-scaled — the game's own
# window is a fixed small size). Managed by install_sonicxg. Replays/options
# live in ~/.config/Sonic_XG.

BIN="{{ dg_sonicxg_bin }}"
if [ ! -x "$BIN" ]; then
  printf '%s\n' "ERROR: Sonic XG not installed ($BIN)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-sonicxg.yml" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_sonicxg_main_output }}" }))'); s.recv(256); s.close()
PY

export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

cd "{{ dg_sonicxg_install_dir }}"
# No /dev/fuse in the migrated gaming container: let the AppImage runtime
# extract and run itself instead of mounting the image.
export APPIMAGE_EXTRACT_AND_RUN=1
exec env -u PYTHONHOME -u PYTHONPATH gamescope {{ dg_sonicxg_gamescope_args }} \
  -- "./$(basename "$BIN")" "$@"
