#!/usr/bin/env sh
set -eu

# {{ item.name }} (MS-DOS) via dosbox-staging. Managed by install_screamer.
#
# Usage:
#   {{ item.slug }}-launch          play in VGA
#   {{ item.slug }}-launch setup    configure controls (SETUP at low cycles —
#                                    it crashes at high cycles)
#   {{ item.slug }}-launch svga     SVGA mode (STARTH; may hard-crash, PCGW)
{% if item.iso_flavor | default(false) %}
#   {{ item.slug }}-launch install  run the CD installer once (interactive:
#                                    source drive D, destination C, dir \SR)
{% endif %}

dosbox="{{ dg_screamer_dosbox_bin }}"
{% if item.iso_flavor | default(false) %}
cdrive="{{ dg_screamer_games_dir }}/{{ item.slug }}/{{ item.hdd_subdir }}"
cd_image="{{ dg_screamer_games_dir }}/{{ item.slug }}/{{ item.iso_rel }}"
{% else %}
cdrive="{{ dg_screamer_games_dir }}/{{ item.slug }}{{ (item.game_subdir | length > 0) | ternary('/' ~ item.game_subdir, '') }}"
cd_image="$cdrive/{{ item.cd_image }}"
{% endif %}

play_exe="{{ item.play_exe }}"
# svga mode = the high-res sibling: swap the trailing ...L.EXE for ...H.EXE
# (STARTL->STARTH, START65L->START65H).
svga_exe="$(printf '%s' "$play_exe" | sed 's/L\.EXE/H.EXE/I')"

mode="${1:-play}"
boot="c"
case "$mode" in
  setup)   exe="{{ item.setup_exe }}"; cycles="{{ item.setup_cycles }}" ;;
  svga)    exe="$svga_exe";            cycles="{{ item.play_cycles }}" ;;
{% if item.iso_flavor | default(false) %}
  install) exe="{{ item.install_bat }}"; cycles="{{ item.play_cycles }}"; boot="d" ;;
{% endif %}
  *)       exe="$play_exe";            cycles="{{ item.play_cycles }}" ;;
esac

# DOS4GW games launch DOS4GW.EXE from the current dir, so cd into the exe's own
# directory before running it (e.g. C:\SR). Split "SR\STARTL.EXE" -> dir "SR",
# base "STARTL.EXE"; a bare "STARTL.EXE" needs no cd.
exe_base="${exe##*\\}"
exe_dir="${exe%\\*}"
[ "$exe_dir" = "$exe" ] && exe_dir=""
cd_line="rem"
[ -n "$exe_dir" ] && cd_line="cd \\$exe_dir"

if [ ! -x "$dosbox" ]; then
  printf '%s\n' "ERROR: dosbox-staging missing ($dosbox). Run: ansible-playbook install-screamer.yml" >&2
  exit 1
fi
{% if item.iso_flavor | default(false) %}
# The CD games install to the HDD first. If it's empty, don't drop the user at a
# cryptic DOS "Illegal command" prompt — point them at the one-time installer.
if [ "$mode" != "install" ] && [ -z "$(ls -A "$cdrive" 2>/dev/null)" ]; then
  printf '%s\n' "{{ item.name }} is not installed yet." >&2
  printf '%s\n' "Run the one-time installer first:" >&2
  printf '%s\n' "  {{ item.slug }}-launch install" >&2
  printf '%s\n' "In the DOS menu: Source drive = D, Destination drive = C, Directory = \\SR, confirm Y." >&2
  exit 1
fi
{% endif %}

# Pin the RTX (dosbox-staging renders OpenGL → GLX vendor pin); keep the pad live.
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# Open on the main landscape 4K monitor (DP-1).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b"/dispatch focusmonitor DP-1"); s.recv(64); s.close()
PY

# Clean config with absolute mounts + GOG's tuned CPU/joystick/SB settings.
# DOS4GW protected mode → cpu_cycles_protected is the count that matters. The
# CD (D:) is mounted for every mode so CD-check / data / audio work without the
# NoCD patch. Committed mapperfile wires the pad to the arrow keys.
conf="$(mktemp "/tmp/{{ item.slug }}-dosbox.XXXXXX.conf")"
cat > "$conf" <<EOF
[sdl]
fullscreen = true
output     = opengl
mapperfile = {{ dg_screamer_mapperfile }}
[dosbox]
machine = {{ item.machine }}
[cpu]
core                 = auto
cputype              = {{ item.cputype }}
cpu_cycles_protected = $cycles
[sblaster]
sbtype = sb16
[joystick]
joysticktype = {{ dg_screamer_joysticktype }}
timed        = false
[autoexec]
@echo off
mount c "$cdrive"
imgmount d "$cd_image" -t iso -fs iso
$boot:
$cd_line
$exe_base
exit
EOF

"$dosbox" -conf "$conf"
status=$?
rm -f "$conf"
exit "$status"
