#!/usr/bin/env sh
# Forza Motorsport 4 (hl360-forza4) — Windows x64 build through GE-Proton.
# Opens the port's SDL3/ImGui launcher; install the two discs there, then Play.
set -eu

A="{{ dg_hl360_app_dir }}"

if [ ! -f "$A/fm4-launcher.exe" ] && [ ! -f "$A/fm4.exe" ]; then
  printf '%s\n' 'The FM4 port is not installed.' >&2
  exit 1
fi

exec distrobox-enter -n {{ dg_box_name }} -- sh -c \
  'cd "$0" && export STEAM_COMPAT_CLIENT_INSTALL_PATH="{{ dg_hl360_steam_root }}" STEAM_COMPAT_DATA_PATH="{{ dg_hl360_compatdata }}" SteamAppId=0 SteamGameId=0 VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}" && exec "{{ dg_hl360_proton }}" run ./fm4-launcher.exe "$@"' \
  "$A" "$@"
