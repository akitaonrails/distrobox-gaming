#!/usr/bin/env sh
set -eu
# Road Rash 64 Recompiled launcher — native N64 recomp (N64Recomp + RT64) on the
# RTX, opens on DP-1. 8BitDo native via SDL. Managed by install_roadrash64_recomp.
# --auto-rom validates + stores the ROM and auto-starts, so the picker is skipped.

APPIMAGE="{{ dg_rr64_appimage }}"
ROM="{{ dg_rr64_rom }}"
if [ ! -x "$APPIMAGE" ]; then
  printf '%s\n' "ERROR: Road Rash 64 Recompiled missing at $APPIMAGE. Run: ansible-playbook install-roadrash64-recomp.yml" >&2
  exit 1
fi
if [ ! -f "$ROM" ]; then
  printf '%s\n' "ERROR: Road Rash 64 (USA) ROM missing at $ROM" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_rr64_main_output }}" }))'); s.recv(256); s.close()
PY

# RT64 renders on Vulkan — pin the nvidia ICD (not the AMD iGPU).
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export __NV_PRIME_RENDER_OFFLOAD="${__NV_PRIME_RENDER_OFFLOAD:-1}"
export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# Run from the AppImage dir so the optional music/ folder beside it is found.
cd "{{ dg_rr64_root }}"
exec "$APPIMAGE" --auto-rom "$ROM" --force-vulkan "$@"
