#!/usr/bin/env sh
set -eu

prefix="{{ dg_dklr_prefix }}"
install_dir="{{ dg_dklr_install_root }}"
wine_bin="{{ dg_dklr_wine_bin }}"
exe="$install_dir/{{ dg_dklr_exe }}"

if [ ! -x "$wine_bin" ] || [ ! -f "$exe" ]; then
  printf '%s\n' "ERROR: DKLR is not installed ($exe)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-dklr.yml" >&2
  exit 1
fi

export WINEPREFIX="$prefix"
export WINEARCH="{{ dg_dklr_winearch }}"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEESYNC="${WINEESYNC:-{{ dg_dklr_wine_esync }}}"
export WINEFSYNC="${WINEFSYNC:-{{ dg_dklr_wine_fsync }}}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-winemenubuilder.exe=d}"
export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-none}"
# Pin the RTX 5090: this Unity/DXVK title renders through Vulkan, and on this
# AMD-iGPU + RTX box an unpinned ICD can land on the iGPU -> black screen (same
# class as Sega Rally Revo). The desktop entry also injects dg_gpu_env.
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

cd "$install_dir"

# --- Focus the main landscape monitor so gamescope opens on DP-1, not the
#     portrait DP-2. hyprctl isn't in the box; talk to the socket via python3.
if command -v python3 >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  python3 - "{{ dg_dklr_main_output }}" <<'PY' >/dev/null 2>&1 || true
import socket, os, sys
sig = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]; xdg = os.environ["XDG_RUNTIME_DIR"]
s = socket.socket(socket.AF_UNIX); s.connect(f"{xdg}/hypr/{sig}/.socket.sock")
s.sendall(f"dispatch focusmonitor {sys.argv[1]}".encode()); s.recv(64)
PY
fi

# --- Controller: DKLR is keyboard-only (README). Bridge the pad to its SNES
#     key map with evsieve (D-pad->arrows; face/shoulders/start/select as below).
#     Physical-position mapping so a SNES-style pad feels right:
#       This pad: A=btn:south B=btn:east X=btn:north Y=btn:west; game jump=X-key roll=Z-key.
#       B(east)->x=jump  A(south)->z=roll  Y(west)->z=roll  X(north)->a  L=Q R=W
#       Start=Return  Select=Backspace
evsieve_pid=""
pad=""
# Belt-and-suspenders: clear anything a previous run may have left holding the
# controller when its cleanup didn't fire (e.g. the launcher was SIGKILLed):
#  - a stale evsieve grab makes the pad emit keys into ES-DE and every app;
#  - an orphaned winedevice.exe keeps /dev/input open and blocks ES-DE/RetroArch
#    from binding the pad even after ES-DE is restarted.
pkill -x evsieve 2>/dev/null || true
env -u PYTHONHOME -u PYTHONPATH WINEPREFIX="$prefix" "{{ dg_dklr_wineserver_bin }}" -k >/dev/null 2>&1 || true
for l in /dev/input/by-id/*8BitDo*event-joystick /dev/input/by-id/*Xbox*event-joystick /dev/input/by-id/*XBOX*event-joystick /dev/input/by-id/*Microsoft*event-joystick; do
  [ -e "$l" ] && { pad=$(readlink -f "$l"); break; }
done
if [ -n "$pad" ] && command -v evsieve >/dev/null 2>&1 && [ -w /dev/uinput ]; then
  evsieve --input "$pad" grab \
    --map btn:east key:x \
    --map btn:south key:z \
    --map btn:north key:a \
    --map btn:west key:z \
    --map btn:tl key:q \
    --map btn:tr key:w \
    --map btn:start key:enter \
    --map btn:select key:backspace \
    --copy abs:hat0x:-1 key:left:1 \
    --copy abs:hat0x:1 key:right:1 \
    --copy abs:hat0x:0 key:left:0 \
    --copy abs:hat0x:0 key:right:0 \
    --copy abs:hat0y:-1 key:up:1 \
    --copy abs:hat0y:1 key:down:1 \
    --copy abs:hat0y:0 key:up:0 \
    --copy abs:hat0y:0 key:down:0 \
    --block abs:hat0x \
    --block abs:hat0y \
    --output name="dklr-keys" >/dev/null 2>&1 &
  evsieve_pid=$!
  # Let the virtual "dklr-keys" keyboard register with the seat BEFORE
  # gamescope enumerates input below -- otherwise gamescope can miss the
  # hotplugged device and none of the mapped keys reach the game.
  sleep 0.5
  # Watchdog in its OWN session: the traps below cover a clean exit and
  # SIGTERM/INT, but NOT SIGKILL (or an orphaned box-side script when the
  # window is closed). This detached guard runs the moment THIS launcher
  # disappears by any means and releases the controller -- BOTH the evsieve
  # grab AND the wine device layer (winedevice.exe), so a killed launcher can
  # never strand the pad as a keyboard or leave it bound away from ES-DE.
  setsid sh -c 'while kill -0 '"$$"' 2>/dev/null; do sleep 2; done; pkill -x evsieve 2>/dev/null; env -u PYTHONHOME -u PYTHONPATH WINEPREFIX="'"$prefix"'" "{{ dg_dklr_wineserver_bin }}" -k >/dev/null 2>&1' >/dev/null 2>&1 &
fi

cleanup() {
  [ -n "$evsieve_pid" ] && kill "$evsieve_pid" 2>/dev/null || true
  # Also sweep by name: $evsieve_pid can be stale if the shell was signalled
  # oddly, and a lingering grab breaks the pad system-wide (ES-DE, Steam, ...).
  pkill -x evsieve 2>/dev/null || true
  env -u PYTHONHOME -u PYTHONPATH "{{ dg_dklr_wineserver_bin }}" -k >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM

set +e
{% if dg_dklr_gamescope_enabled | bool -%}
if command -v gamescope >/dev/null 2>&1; then
  # Integer-scale the 256x224 pixel canvas to the panel for crisp pixels.
  env -u PYTHONHOME -u PYTHONPATH gamescope \
    -w {{ dg_dklr_game_width }} -h {{ dg_dklr_game_height }} \
    -W {{ dg_dklr_output_width }} -H {{ dg_dklr_output_height }} \
    -S integer -f \
    -- "$wine_bin" "$exe" -screen-fullscreen 1 \
       -screen-width {{ dg_dklr_game_width }} -screen-height {{ dg_dklr_game_height }} "$@"
else
  "$wine_bin" "$exe" "$@"
fi
{% else -%}
"$wine_bin" "$exe" "$@"
{% endif -%}
status=$?
set -e
trap - EXIT HUP INT TERM
cleanup
exit "$status"
