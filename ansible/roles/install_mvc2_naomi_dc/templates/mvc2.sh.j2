#!/bin/sh
# Marvel vs. Capcom 2 — NAOMI/Dreamcast decomp port (Windows build under Wine).
# Managed by install_mvc2_naomi_dc.
set -eu

if [ ! -e /.dockerenv ]; then
  exec distrobox-enter -n {{ dg_box_name }} -- sh "$0" "$@"
fi

if [ ! -x "{{ dg_mvc2_exe }}" ]; then
  printf '%s\n' "ERROR: MVC2 missing at {{ dg_mvc2_exe }}." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-mvc2-naomi-dc.yml" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_mvc2_main_output }}" }))'); s.recv(256); s.close()
PY

export WINEPREFIX="{{ dg_mvc2_prefix }}"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-winemenubuilder.exe=d}"
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export __NV_PRIME_RENDER_OFFLOAD="${__NV_PRIME_RENDER_OFFLOAD:-1}"
export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
# SDL_GPU uses Vulkan under Wine (Direct3D 12 would need vkd3d-proton here).
export SDL_GPU_DRIVER=vulkan
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

cd "{{ dg_mvc2_root }}"
exec wine mvc2.exe "$@"