# Initial controller-friendly Doom II RT baseline.
# PrBoom rewrites this file on a clean exit; Ansible never overwrites it.
autorun 1
screen_resolution "{{ dg_prboom_rt_width }}x{{ dg_prboom_rt_height }}"
use_fullscreen 1
use_mouse 1
mouse_sensitivity_horiz 10
mouse_sensitivity_mlook 10
movement_mouselook 1
movement_mousenovert 1
movement_mouseinvert 0
render_fov 100
use_joystick 0
key_use 13
key_prevweapon 113
key_nextweapon 101
