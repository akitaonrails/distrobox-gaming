<?xml version="1.0" encoding="UTF-8"?>
<gamecontroller configversion="19" appversion="3.6.1">
    <sdlname>SDL Game Controller</sdlname>
    <profilename>Doom II Ray Traced</profilename>
    <names/>
    <sets>
        <set index="1">
            <!-- Left stick: WASD movement. All 8 zones mapped so diagonals
                 (forward+strafe) work, not just the 4 cardinals. -->
            <stick index="1">
                <diagonalRange>45</diagonalRange>
                <stickbutton index="1"><slots><slot><code>0x57</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="2"><slots><slot><code>0x57</code><mode>keyboard</mode></slot><slot><code>0x44</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="3"><slots><slot><code>0x44</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="4"><slots><slot><code>0x53</code><mode>keyboard</mode></slot><slot><code>0x44</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="5"><slots><slot><code>0x53</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="6"><slots><slot><code>0x53</code><mode>keyboard</mode></slot><slot><code>0x41</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="7"><slots><slot><code>0x41</code><mode>keyboard</mode></slot></slots></stickbutton>
                <stickbutton index="8"><slots><slot><code>0x57</code><mode>keyboard</mode></slot><slot><code>0x41</code><mode>keyboard</mode></slot></slots></stickbutton>
            </stick>
            <!-- Right stick: mouse look. All 8 zones mapped (mousemovement
                 1=up 2=down 3=left 4=right) so diagonal + straight-down look
                 works — the old profile left diagonals dead, so you could look
                 up but not reliably back down. -->
            <stick index="2">
                <diagonalRange>45</diagonalRange>
                <stickbutton index="1"><mousespeedx>55</mousespeedx><mousespeedy>55</mousespeedy><slots><slot><code>1</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="2"><mousespeedx>55</mousespeedx><mousespeedy>55</mousespeedy><slots><slot><code>1</code><mode>mousemovement</mode></slot><slot><code>4</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="3"><mousespeedx>55</mousespeedx><mousespeedy>55</mousespeedy><slots><slot><code>4</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="4"><mousespeedx>55</mousespeedx><mousespeedy>55</mousespeedy><slots><slot><code>2</code><mode>mousemovement</mode></slot><slot><code>4</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="5"><mousespeedx>55</mousespeedx><mousespeedy>55</mousespeedy><slots><slot><code>2</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="6"><mousespeedx>55</mousespeedx><mousespeedy>55</mousespeedy><slots><slot><code>2</code><mode>mousemovement</mode></slot><slot><code>3</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="7"><mousespeedx>55</mousespeedx><mousespeedy>55</mousespeedy><slots><slot><code>3</code><mode>mousemovement</mode></slot></slots></stickbutton>
                <stickbutton index="8"><mousespeedx>55</mousespeedx><mousespeedy>55</mousespeedy><slots><slot><code>1</code><mode>mousemovement</mode></slot><slot><code>3</code><mode>mousemovement</mode></slot></slots></stickbutton>
            </stick>
            <dpad index="1">
                <dpadbutton index="1"><slots><slot><code>0x1000013</code><mode>keyboard</mode></slot></slots></dpadbutton>
                <dpadbutton index="2"><slots><slot><code>0x1000014</code><mode>keyboard</mode></slot></slots></dpadbutton>
                <dpadbutton index="4"><slots><slot><code>0x1000015</code><mode>keyboard</mode></slot></slots></dpadbutton>
                <dpadbutton index="8"><slots><slot><code>0x1000012</code><mode>keyboard</mode></slot></slots></dpadbutton>
            </dpad>
            <!-- LT (trigger 1): walk/slow. RT (trigger 2): fire. -->
            <trigger index="1">
                <triggerbutton index="2"><actionname>Walk</actionname><slots><slot><code>0x1000020</code><mode>keyboard</mode></slot></slots></triggerbutton>
            </trigger>
            <trigger index="2">
                <triggerbutton index="2"><actionname>Fire</actionname><slots><slot><code>1</code><mode>mousebutton</mode></slot></slots></triggerbutton>
            </trigger>
            <!-- Buttons use standard SDL game-controller indices (1-based):
                 1=A 2=B 3=X 4=Y 5=Back 6=Guide 7=Start 8=L3 9=R3 10=LB 11=RB.
                 Weapon prev/next live on the shoulders (10/11), matching the
                 documented layout; the old profile had them on Back/Guide. -->
            <button index="1"><actionname>Use / Select</actionname><slots><slot><code>0x1000004</code><mode>keyboard</mode></slot></slots></button>
            <button index="2"><actionname>Back</actionname><slots><slot><code>0x1000000</code><mode>keyboard</mode></slot></slots></button>
            <button index="3"><actionname>Quicksave</actionname><slots><slot><code>0x1000035</code><mode>keyboard</mode></slot></slots></button>
            <button index="4"><actionname>Flashlight</actionname><slots><slot><code>0x46</code><mode>keyboard</mode></slot></slots></button>
            <button index="5"><actionname>Automap</actionname><slots><slot><code>0x1000001</code><mode>keyboard</mode></slot></slots></button>
            <button index="7"><actionname>Menu</actionname><slots><slot><code>0x1000000</code><mode>keyboard</mode></slot></slots></button>
            <button index="8"><actionname>Quickload</actionname><slots><slot><code>0x1000038</code><mode>keyboard</mode></slot></slots></button>
            <button index="9"><actionname>Fists / Chainsaw</actionname><slots><slot><code>0x31</code><mode>keyboard</mode></slot></slots></button>
            <button index="10"><actionname>Previous Weapon</actionname><slots><slot><code>0x51</code><mode>keyboard</mode></slot></slots></button>
            <button index="11"><actionname>Next Weapon</actionname><slots><slot><code>0x45</code><mode>keyboard</mode></slot></slots></button>
        </set>
    </sets>
</gamecontroller>
