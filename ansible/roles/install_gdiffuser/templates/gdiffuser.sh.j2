#!/usr/bin/env sh
# G-Diffuser (F-Zero X PC port, libultraship) launcher — native SDL/OpenGL.
set -eu

install_dir="{{ dg_gdiffuser_install_dir }}"
exe="$install_dir/{{ dg_gdiffuser_exe }}"

if [ ! -x "$exe" ]; then
  printf '%s\n' "ERROR: G-Diffuser is not installed ($exe)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-gdiffuser.yml" >&2
  exit 1
fi

# Pin the RTX on this dual-GPU box (libultraship uses OpenGL/Fast3D here; also
# pin the Vulkan ICD in case a driver update flips the backend).
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# All games must open on the main landscape 4K monitor (DP-1).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b"/dispatch focusmonitor DP-1"); s.recv(64); s.close()
PY

# G-Diffuser reads its .o2r archives + game files relative to the executable.
cd "$install_dir"
exec ./{{ dg_gdiffuser_exe }} "$@"
