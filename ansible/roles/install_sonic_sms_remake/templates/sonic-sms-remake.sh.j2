#!/usr/bin/env sh
set -eu
# Sonic SMS Remake launcher — GameMaker exe under wine-11.8 in a 4K Wine
# virtual desktop (exclusive fullscreen otherwise renders in a corner of the
# panel). Managed by install_sonic_sms_remake. 8BitDo via WineBus SDL.

EXE="{{ dg_sms_install_dir }}/{{ dg_sms_exe }}"
if [ ! -f "$EXE" ]; then
  printf '%s\n' "ERROR: Sonic SMS Remake not installed ($EXE)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-sonic-sms-remake.yml" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_sms_main_output }}" }))'); s.recv(256); s.close()
PY

export WINEPREFIX="{{ dg_sms_prefix }}"
export PATH="{{ dg_sms_wine_bin_dir }}:$PATH"
export WINEDEBUG=-all
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

cd "{{ dg_sms_install_dir }}"
exec env -u PYTHONHOME -u PYTHONPATH "{{ dg_sms_wine_bin_dir }}/wine" \
  explorer /desktop=sms,{{ dg_sms_desktop_res }} "$EXE" "$@"
