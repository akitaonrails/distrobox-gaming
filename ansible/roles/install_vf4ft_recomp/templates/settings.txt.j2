# Virtua Fighter 4 Final Tuned — display settings seeded by distrobox-gaming.
# The game owns this file after the first launch; F10-menu changes are saved
# back here. Only the display keys are set; the game's defaults fill the rest
# (free play, Japan region, the PlayStation 2 control layout). 4K on DP-1 via
# the GPU (Vulkan) renderer at its top internal resolution.
fullscreen = {{ dg_vf4ft_fullscreen }}
picture = {{ dg_vf4ft_picture }}
window = {{ dg_vf4ft_window }}
renderer = {{ dg_vf4ft_renderer }}
scale = {{ dg_vf4ft_scale }}
