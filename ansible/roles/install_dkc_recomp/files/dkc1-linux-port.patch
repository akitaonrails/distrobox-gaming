@@ -29,7 +29,26 @@
 
 #include <float.h>
 #include <limits.h>
+#ifdef __APPLE__
 #include <mach/mach_time.h>
+#else /* Linux port shim: mach timing via the monotonic clock (1 tick = 1 ns,
+         so timebase 1/1 keeps FramePacerInit's math exact). */
+#include <stdint.h>
+#include <time.h>
+typedef struct mach_timebase_info { uint32_t numer, denom; } mach_timebase_info_data_t;
+static inline void mach_timebase_info(mach_timebase_info_data_t *tb) {
+  tb->numer = 1u; tb->denom = 1u;
+}
+static inline uint64_t mach_absolute_time(void) {
+  struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+static inline int mach_wait_until(uint64_t deadline) {
+  struct timespec ts = { (time_t)(deadline / 1000000000ull),
+                         (long)(deadline % 1000000000ull) };
+  return clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL);
+}
+#endif
