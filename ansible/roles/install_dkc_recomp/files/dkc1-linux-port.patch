+# --- Linux desktop target (distrobox-gaming install_dkc_recomp) ---
+if(UNIX AND NOT APPLE)
+    add_executable(dkc1_linux
+        ${DKC1_ENGINE_SOURCES}
+        ${DKC1_SNESRECOMP_GEN_SOURCES}
+        ${DKC1_RUNNER_SOURCES}
+        runner/headless_host.c
