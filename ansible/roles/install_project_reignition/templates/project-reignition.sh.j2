#!/usr/bin/env sh
set -eu
# Project Reignition (Sonic and the Secret Rings remake) launcher — native
# Godot 4 (.NET), Vulkan Forward+ on the RTX, DP-1. Managed by
# install_project_reignition. Game data is self-contained; saves/settings live
# in the Godot user:// dir.

install_dir="{{ dg_project_reignition_install_dir }}"
exe="$install_dir/{{ dg_project_reignition_exe }}"

if [ ! -x "$exe" ]; then
  printf '%s\n' "ERROR: Project Reignition is not installed ($exe)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-project-reignition.yml" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_project_reignition_main_output }}" }))'); s.recv(256); s.close()
PY

# Pin the RTX (Godot 4.7 renders Vulkan Forward+; GL fallback pinned too).
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# Bundled GDExtension ffmpeg libs (libav*) sit next to the exe.
cd "$install_dir"
LD_LIBRARY_PATH="$install_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" exec "./{{ dg_project_reignition_exe }}" "$@"
