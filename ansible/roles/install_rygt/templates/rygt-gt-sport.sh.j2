#!/usr/bin/env sh
# GT Sport (RyGT) — Windows build through the box's Wine. The wrapper runs on
# the host, so the game itself must be started inside the gaming distrobox,
# where Wine and the Vulkan loader live.
set -eu

exec distrobox-enter -n {{ dg_box_name }} -- sh -c \
  'cd "$0" && \
   export WINEPREFIX="{{ dg_rygt_prefix }}" \
          WINEDEBUG=-all \
          VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}" && \
   exec wine ./GTSport.exe "$@"' \
  "{{ dg_rygt_release_dir }}" "$@"
