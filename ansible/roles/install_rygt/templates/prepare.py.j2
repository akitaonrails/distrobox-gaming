#!/usr/bin/env python3
"""Prepare RyGT's own view of a backported GT Sport dump."""

import json
from pathlib import Path
import sys


mode, game_name, overlay_name, release_name = sys.argv[1:]
game = Path(game_name)
overlay = Path(overlay_name)
release = Path(release_name)
changed = False

if mode == "before":
    source = (game / "sce_sys/param.sfo").read_bytes()
    if source.count(b"01.00\0") != 1:
        raise SystemExit("expected one backport APP_VER=01.00; inspect dump before conversion")
    target = overlay / "sce_sys/param.sfo"
    patched = source.replace(b"01.00\0", b"01.69\0", 1)
    if not target.exists() or target.read_bytes() != patched:
        target.write_bytes(patched)
        changed = True
    eboot = overlay / "eboot.bin"
    if not eboot.is_symlink():
        if eboot.exists():
            raise SystemExit("refusing to replace existing update eboot.bin")
        eboot.symlink_to(game / "eboot.bin")
        changed = True
elif mode == "after":
    output = release / "app0/sce_sys"
    source = game / "sce_sys"
    if output.is_symlink():
        if output.resolve() not in {source.resolve(), (overlay / "sce_sys").resolve()}:
            raise SystemExit("refusing to replace unexpected sce_sys symlink")
        output.unlink()
        output.mkdir()
        changed = True
    elif output.is_dir():
        if not list(output.iterdir()):
            changed = True
    else:
        raise SystemExit("converter did not create app0/sce_sys")
    for entry in source.iterdir():
        link = output / entry.name
        if link.is_symlink() and link.resolve() == entry.resolve():
            continue
        if link.exists() or link.is_symlink():
            raise SystemExit(f"refusing to replace existing {link}")
        link.symlink_to(entry)
        changed = True
    metadata = output / "param.json"
    if not metadata.exists():
        metadata.write_text(json.dumps({
            "titleId": "CUSA03220",
            "defaultLanguage": "en-US",
            "localizedParameters": {"en-US": {"titleName": "Gran Turismo Sport"}},
        }, indent=2) + "\n")
        changed = True
else:
    raise SystemExit("expected before or after")

print("changed" if changed else "ok")
