#!/usr/bin/env sh
set -eu

# ES-DE launcher for Supermodel (Sega Model 3).
#
# The AUR package's /usr/bin/supermodel wrapper is unusable from a
# frontend: it ignores its arguments entirely (launches a bare
# supermodel-binary with no ROM), hard-fails behind a zenity prompt
# unless a ROMs dir exists, and seeds ~/.config/supermodel — a path
# this build never reads. The actual binary (0.3a-WIP, checked
# 2026-07-13) resolves everything under ~/.supermodel/ absolutely:
#   ~/.supermodel/Config/   Games.xml, Music.xml, Supermodel.ini
#   ~/.supermodel/NVRAM, Saves, Screenshots, Assets
# This wrapper seeds that layout from /usr/share/supermodel on first
# run, then passes the ROM (and any extra flags) straight through.

sm_dir="$HOME/.supermodel"

if [ ! -f "$sm_dir/Config/Games.xml" ]; then
  install -Dm644 /usr/share/supermodel/Config/Games.xml "$sm_dir/Config/Games.xml"
fi
if [ ! -f "$sm_dir/Config/Music.xml" ]; then
  install -Dm644 /usr/share/supermodel/Config/Music.xml "$sm_dir/Config/Music.xml"
fi
if [ ! -d "$sm_dir/Assets" ]; then
  cp -r /usr/share/supermodel/Assets "$sm_dir/"
fi
mkdir -p "$sm_dir/NVRAM" "$sm_dir/Saves" "$sm_dir/Screenshots"

# Select+Start on any connected pad quits (Supermodel's UIExit is
# Escape): evsieve watches the pads (no grab) and injects Esc on a
# virtual keyboard when the chord fires. Same pattern as azahar-launch.
evsieve_pid=""
if command -v evsieve >/dev/null 2>&1 && [ -w /dev/uinput ]; then
  pad_inputs=""
  for l in /dev/input/by-id/*8BitDo*Ultimate*event-joystick \
           /dev/input/by-id/*Xbox*event-joystick \
           /dev/input/by-id/*XBOX*event-joystick; do
    [ -e "$l" ] && pad_inputs="$pad_inputs --input $(readlink -f "$l")"
  done
  if [ -n "$pad_inputs" ]; then
    # shellcheck disable=SC2086
    evsieve $pad_inputs \
      --hook btn:select btn:start send-key=key:esc \
      --output name="supermodel-exit-keys" key:esc >/dev/null 2>&1 &
    evsieve_pid=$!
  fi
fi
cleanup() { [ -n "$evsieve_pid" ] && kill "$evsieve_pid" 2>/dev/null || true; }
trap cleanup EXIT INT TERM HUP

# Two Hyprland tweaks before launch, via the shared socket (hyprctl isn't
# installed in the box and distrobox-host-exec can't reach it — exit 127 —
# so talk to the socket with python3; best-effort, harmless off Hyprland):
#
#  1. Focus the main HORIZONTAL monitor. SDL exclusive fullscreen targets
#     the focused output; if focus is on the portrait DP-2 (2160x3840) the
#     3840x2160 mode-set fails ("no matching video modes").
#  2. Re-assert xwayland:force_zero_scaling=true (omarchy's default). CMR2's
#     host wrapper flips it false and only restores it via a hyprctl reload
#     trap, which a force-kill/SIGKILL of that wrapper skips — leaving it
#     off. With it off, Supermodel's native-4K exclusive fullscreen is
#     treated as logical pixels and overflows the 1.5x-scaled panel (game
#     visible but zoomed). Asserting it true here self-heals that leak.
main_output="${DG_MAIN_OUTPUT:-DP-1}"
if command -v python3 >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  python3 - "$main_output" <<'PY' >/dev/null 2>&1 || true
import socket, os, sys
sig = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]; xdg = os.environ["XDG_RUNTIME_DIR"]
s = socket.socket(socket.AF_UNIX); s.connect(f"{xdg}/hypr/{sig}/.socket.sock")
s.sendall(f"[[BATCH]]dispatch focusmonitor {sys.argv[1]}; keyword xwayland:force_zero_scaling true".encode()); s.recv(64)
PY
fi

# Render directly on the RTX 5090 via XWayland — NO gamescope.
#
# Supermodel only applies its 4K resolution in EXCLUSIVE fullscreen; its
# windowed/borderless path ignores -res and opens a tiny 496x384 window.
# Exclusive fullscreen needs a real video mode. SDL2 defaults to its
# Wayland backend under Hyprland, which exposes NO modes — that is the
# "Unable to enter fullscreen mode: Couldn't find any matching video
# modes" error. Forcing SDL onto X11 (SDL_VIDEODRIVER=x11) makes it use
# XWayland, which DOES expose the monitor's real 3840x2160@240 mode, so
# -fullscreen succeeds natively at 4K on the focused (main) output.
#
# We do NOT use gamescope: 3.16.25 regressed badly here. The 7950X3D's
# integrated Radeon now exposes a RADV Vulkan device, and gamescope grabs
# that iGPU to composite (epilepsy-flicker, game never advances) or, when
# pointed at NVIDIA, hits "vkGetPhysicalDeviceFormatProperties2 returned
# zero modifiers" DRM bugs (black screen). Native XWayland has none of it.
#
# Hard-pin the RTX 5090 so GL/Vulkan never fall back to the iGPU:
#   __GLX_VENDOR_LIBRARY_NAME=nvidia + __NV_PRIME_RENDER_OFFLOAD=1 route
#   Supermodel's OpenGL (GLX) to the NVIDIA driver; the VK_* vars keep any
#   Vulkan off the iGPU too. Verified renderer: "NVIDIA 610.43.03".
# NOT exec: runs as a child so the EXIT trap still stops evsieve.
sm_env="SDL_VIDEODRIVER=x11 __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only"
if [ -f /usr/share/vulkan/icd.d/nvidia_icd.json ]; then
  sm_env="$sm_env VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json"
fi
# shellcheck disable=SC2086
env -u PYTHONHOME -u PYTHONPATH $sm_env \
  /usr/bin/supermodel-binary "$@" -res=3840,2160 -fullscreen
