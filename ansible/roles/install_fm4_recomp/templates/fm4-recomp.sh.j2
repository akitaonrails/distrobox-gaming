#!/usr/bin/env sh
# Forza Motorsport 4 Recompiled — Windows x64 player through GE-Proton
# (vkd3d-proton for the D3D12 ROV path). Mirrors the upstream Launch FM4.bat:
# explicit game/user/cache roots, saves stay in the stable user dir.
set -eu

APP="{{ dg_fm4_recomp_release_dir }}"
PROTON="{{ dg_fm4_recomp_proton }}"

if [ ! -f "$APP/fm4.exe" ]; then
  printf '%s\n' 'FM4 Recompiled is not installed.' >&2
  exit 1
fi
if [ ! -f "$APP/game/default.xex" ]; then
  printf '%s\n' 'FM4 game tree is missing (see docs/fm4-recomp.md).' >&2
  exit 1
fi
if [ ! -x "$PROTON" ]; then
  printf '%s\n' 'Configured Proton build is missing.' >&2
  exit 1
fi

export STEAM_COMPAT_CLIENT_INSTALL_PATH="{{ dg_fm4_recomp_steam_root }}"
export STEAM_COMPAT_DATA_PATH="{{ dg_fm4_recomp_compatdata }}"
export SteamAppId=0
export SteamGameId=0
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
mkdir -p "$STEAM_COMPAT_DATA_PATH"

# Proton maps the filesystem root as Z:. The exe accepts \\?\ long-path roots,
# same as the upstream .bat.
WIN_APP="Z:{{ dg_fm4_recomp_release_dir | regex_replace('/', '\\\\') }}"
cd "$APP"
exec "$PROTON" run "$APP/fm4.exe" \
  --game_data_root="\\\\?\\$WIN_APP\\game" \
  --user_data_root="\\\\?\\$WIN_APP\\user" \
  --cache_root="\\\\?\\$WIN_APP\\user\\cache" \
  "$@"
