#!/usr/bin/env sh
# GT4Recomp 1.3.0-rc6 — portable launcher GUI under Wine. Run once to install
# both games (retail GT4 + Spec II) from their disc images; after that the
# standalone game exes also work directly.
set -eu

R="{{ dg_gt4r_130_release }}"
WINEPREFIX="{{ dg_gt4r_prefix }}"

if [ ! -f "$R/GT4Recomp.exe" ]; then
  printf '%s\n' 'GT4Recomp 1.3.0-rc6 is not extracted.' >&2
  exit 1
fi

export WINEPREFIX
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia

cd "$R"
exec wine GT4Recomp.exe "$@"
