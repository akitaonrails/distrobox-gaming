#!/usr/bin/env sh
# GT4Recomp 1.3.0-rc6 — portable launcher GUI under Wine (inside the gaming
# box, where Wine lives). Run once to install both games from their disc
# images; after that the standalone game exes also work directly.
set -eu

R="{{ dg_gt4r_130_release }}"

if [ ! -f "$R/GT4Recomp.exe" ]; then
  printf '%s\n' 'GT4Recomp 1.3.0-rc6 is not extracted.' >&2
  exit 1
fi

exec distrobox-enter -n {{ dg_box_name }} -- sh -c \
  'cd "$0" && export WINEPREFIX="{{ dg_gt4r_prefix }}" VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}" __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia && exec wine GT4Recomp.exe "$@"' \
  "$R" "$@"
