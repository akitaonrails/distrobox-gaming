#!/usr/bin/env sh
# GT4Recomp v1.3.0-rc6 — direct standalone launch. The upstream launcher GUI
# is a Tauri app that needs Microsoft Edge WebView2, which Wine does not
# provide, so the game executable is started with the same settings the GUI
# would apply. Wine accepts forward-slash Z: paths.
#
# `--fullscreen` is NOT optional: without it the standalone never creates its
# host window — and never starts its audio thread — so the game boots into the
# void and waits at its first prompt with no picture or sound. GT4_FULLSCREEN=1
# alone does not create the window; the flag does.
#
# GT4_MONITOR is passed through `env` on purpose: Wine wants the literal
# device name \\.\DISPLAY2 (two backslashes), and putting it inside the quoted
# `sh -c` string would eat one level of escaping.
set -eu

# Re-exec inside the gaming distrobox when started on the host; when a caller
# already entered the box, /.dockerenv is present and Wine runs directly (a
# nested distrobox-enter would fail — there is none inside the box).
if [ ! -e /.dockerenv ]; then
  exec distrobox-enter -n {{ dg_box_name }} -- sh "$0" "$@"
fi

R="{{ dg_gt4r_130_release }}"

if [ ! -f "$R/game/gt4.exe" ]; then
  printf '%s\n' 'GT4Recomp v1.3.0 is not extracted.' >&2
  exit 1
fi
if [ ! -f "$R/data/games/gt4/prepared/SCUS_973.28" ]; then
  printf '%s\n' 'The prepared GT4 executable is missing (re-run the playbook).' >&2
  exit 1
fi

# We are inside the box here (guard above). Wine wants the literal device
# name \\.\DISPLAY2 (two backslashes), so GT4_MONITOR is quoted verbatim.
cd "$R/game"
export WINEPREFIX="{{ dg_gt4r_prefix }}"
export WINEDEBUG=-all
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export GT4_MONITOR='{{ dg_gt4r_monitor }}'
export GT4_INPUT=sdl
export GT4_RENDERER=donor
export GT4_FORCE_480P=1
export GT4_FORCE_WIDESCREEN=1
export GT4_FULLSCREEN=1
export GT4_OUTPUT_SIZE="{{ dg_gt4r_output_size }}"
export GT4_PRESENT_MODE=fifo
exec wine ./gt4.exe ../data/games/gt4/prepared/SCUS_973.28 --ntsc --fullscreen \
     --memcard "Z:{{ dg_gt4r_memcard }}" \
     --disc "Z:{{ dg_gt4r_iso }}" "$@"
