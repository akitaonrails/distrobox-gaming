#!/usr/bin/env sh
set -eu

if [ ! -e /.dockerenv ]; then
  exec distrobox-enter -n {{ dg_box_name }} -- sh "$0" "$@"
fi

game_dir="{{ dg_sr2_install_dir }}"
prefix="{{ dg_sr2_prefix }}"
if [ "${1:-}" = status ]; then
  test -f "$game_dir/SEGA RALLY 2.exe"
  test -f "$game_dir/music/track14.wav"
  test -f "$prefix/system.reg"
  printf 'Sega Rally 2 ready: %s\n' "$game_dir"
  exit 0
fi

export WINEPREFIX="$prefix" WINEDEBUG="${WINEDEBUG:--all}"
export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
export SDL_JOYSTICK_HIDAPI="${SDL_JOYSTICK_HIDAPI:-{{ dg_pc_racing_sdl_hidapi }}}"
export SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT="${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-{{ dg_pc_racing_gamepad_only }}}"
cd "$game_dir"
cleanup() {
  WINEPREFIX="$prefix" wineserver -k >/dev/null 2>&1 || true
}
trap cleanup 0
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
env -u PYTHONHOME -u PYTHONPATH wine 'SEGA RALLY 2.exe' "$@"
