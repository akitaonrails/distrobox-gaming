#!/usr/bin/env sh
# Azimuth hub — the wrapper's own launcher: game picker, per-game settings,
# photo gallery, save backups and updates. One install serves every Forza
# title (FH2, FH2 F&F, FH3, FM5, FM6); the per-game bin/azimuth-<slug>
# shortcuts boot straight into one game with --game --skip-launcher.
set -eu

if [ ! -f "{{ dg_azimuth_install_dir }}/azimuth.exe" ]; then
  printf '%s\n' 'Azimuth is not installed.' >&2
  exit 1
fi
if [ ! -f "{{ dg_azimuth_game_dir }}/era.vbi" ]; then
  printf '%s\n' 'Forza Horizon 2 game files are missing.' >&2
  exit 1
fi
if [ ! -x "{{ dg_azimuth_proton }}" ]; then
  printf '%s\n' 'Configured Proton executable is missing.' >&2
  exit 1
fi

export STEAM_COMPAT_CLIENT_INSTALL_PATH="{{ dg_azimuth_steam_root }}"
export STEAM_COMPAT_DATA_PATH="{{ dg_azimuth_compatdata }}"
export SteamAppId=0
export SteamGameId=0
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export WINEDLLOVERRIDES="winmm=n,b;d3dcompiler_47=n,b${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
mkdir -p "$STEAM_COMPAT_DATA_PATH"
cd "{{ dg_azimuth_install_dir }}"
exec "{{ dg_azimuth_proton }}" run "{{ dg_azimuth_install_dir }}/azimuth.exe" "$@"
