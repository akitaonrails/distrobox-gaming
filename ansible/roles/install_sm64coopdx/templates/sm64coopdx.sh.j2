#!/usr/bin/env sh
# Super Mario 64 Coop Deluxe launcher — SDL2 + OpenGL PC port.
set -eu

install="{{ dg_sm64coopdx_install_dir }}"
exe="{{ dg_sm64coopdx_exe }}"

if [ ! -x "$exe" ]; then
  printf '%s\n' "ERROR: sm64coopdx is not installed ($exe)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-sm64coopdx.yml" >&2
  exit 1
fi
if [ ! -f "$install/baserom.us.z64" ]; then
  printf '%s\n' "ERROR: baserom.us.z64 missing next to sm64coopdx ($install)." >&2
  printf '%s\n' "Re-run the playbook; it prepares the verified US SM64 baserom." >&2
  exit 1
fi

# Pin the RTX on this dual-GPU box (renderer is OpenGL → GLX/PRIME vendor pin;
# also pin the Vulkan ICD defensively). SDL background events keep the pad live.
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# All games open on the main landscape 4K monitor (DP-1).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b"/dispatch focusmonitor DP-1"); s.recv(64); s.close()
PY

# cd into the install dir: the binary's RUNPATH is CWD-relative (".:lib/discordsdk"),
# so this is how it finds the bundled libdiscord_game_sdk.so, and where it reads
# its dynos/mods/lang data and the baserom for first-run asset extraction.
cd "$install"
exec "$exe" "$@"
