#!/usr/bin/env sh
set -eu
# Sonic Classic launcher — Clickteam MMF2 exe under wine-11.8, presented
# fullscreen by gamescope (integer-scaled, 60 fps cap). Managed by
# install_sonic_classic. 8BitDo via WineBus SDL.

GAMEDIR="{{ dg_sclassic_gamedir }}"
EXE="$GAMEDIR/{{ dg_sclassic_exe }}"
if [ ! -f "$EXE" ]; then
  printf '%s\n' "ERROR: Sonic Classic not installed ($EXE)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-sonic-classic.yml" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_sclassic_main_output }}" }))'); s.recv(256); s.close()
PY

export WINEPREFIX="{{ dg_sclassic_prefix }}"
export PATH="{{ dg_sclassic_wine_bin_dir }}:$PATH"
export WINEDEBUG=-all
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# MMF2 resolves BG_Music/, Ghosts/ and ringdata.sav relative to the exe's dir.
cd "$GAMEDIR"
# gamescope presents the game's window fullscreen, integer-scaled, capped at
# 60 fps so the Clickteam runtime's 240 Hz "held button" double-fire does not
# happen; it also subsumes the corner-render modeswitch fix.
exec env -u PYTHONHOME -u PYTHONPATH gamescope {{ dg_sclassic_gamescope_args }} \
  -- "{{ dg_sclassic_wine_bin_dir }}/wine" "$EXE" "$@"
