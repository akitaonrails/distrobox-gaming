diff --git a/src/main/sdl2/renderbase.cpp b/src/main/sdl2/renderbase.cpp
index 6824ee3..c828175 100755
--- a/src/main/sdl2/renderbase.cpp
+++ b/src/main/sdl2/renderbase.cpp
@@ -36,7 +36,29 @@ bool RenderBase::sdl_screen_size()
     {
 	SDL_DisplayMode info;
 
-	SDL_GetCurrentDisplayMode(0, &info);
+        // Prefer a landscape monitor (width >= height) with the largest area.
+        // On multi-head setups SDL display 0 may be a portrait panel, which
+        // would size the game for a portrait screen and leave it rendering in a
+        // corner of the landscape display it is actually shown on.
+        display_index = 0;
+        int best_area = -1;
+        int n = SDL_GetNumVideoDisplays();
+        for (int i = 0; i < n; i++)
+        {
+            SDL_DisplayMode dm;
+            if (SDL_GetCurrentDisplayMode(i, &dm) != 0)
+                continue;
+            if (dm.w < dm.h)   // skip portrait panels
+                continue;
+            int area = dm.w * dm.h;
+            if (area > best_area)
+            {
+                best_area = area;
+                display_index = i;
+            }
+        }
+
+	SDL_GetCurrentDisplayMode(display_index, &info);
 
         orig_width  = info.w;
         orig_height = info.h;
