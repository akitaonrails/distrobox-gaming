#!/usr/bin/env sh
set -eu
# Star Fox Enhanced (SNES Star Fox source port) launcher — official NATIVE
# linux build (v0.0.3+), SDL/OpenGL on the RTX, DP-1. Managed by
# install_starfox_enhanced. First launch validates the Rev 2 ROM beside the
# executable and writes Starfox-Assets.BIN. Select+Start exits.

BIN="{{ dg_sfe_game_dir }}/starfox_pc"
if [ ! -x "$BIN" ]; then
  printf '%s\n' "ERROR: Star Fox Enhanced not installed ($BIN)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-starfox-enhanced.yml" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_sfe_main_output }}" }))'); s.recv(256); s.close()
PY

# Pin the RTX on this dual-GPU box (GL and, if the renderer uses it, Vulkan).
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1

# ROM, Starfox-Assets.BIN and the optional MSU-1 PAK live beside the exe.
cd "{{ dg_sfe_game_dir }}"
exec ./starfox_pc "$@"
