#!/bin/sh
# Daytona USA 2 Power Edition (Web) — the static WASM/WebGPU cabinet served
# from this machine and played in a Chromium app window. Managed by
# install_daytona2_web; see docs/daytona2-web.md.
#
# Runs on the *host* on purpose: the browser is host software, and the page
# only needs a local HTTP origin for its worker + WASM JSPI modules.
set -eu

ROOT="{{ dg_daytona2_web_root }}"
PORT="{{ dg_daytona2_web_port }}"
PROFILE="{{ dg_daytona2_web_profile }}"
BROWSER="{{ dg_daytona2_web_browser }}"
BASE="http://127.0.0.1:${PORT}"
URL="${BASE}/?rom=1"

if [ ! -f "$ROOT/index.html" ] || [ ! -f "$ROOT/daytona2.wasm" ]; then
  printf '%s\n' "ERROR: Daytona USA 2 Web is not installed at $ROOT." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-daytona2-web.yml" >&2
  exit 1
fi
if [ ! -e "{{ dg_daytona2_web_rom_link }}" ]; then
  printf '%s\n' "ERROR: the owned ROM is not linked at {{ dg_daytona2_web_rom_link }}." >&2
  printf '%s\n' "Expected {{ dg_daytona2_web_rom }} (your own dayto2pe MAME set)." >&2
  exit 1
fi
if ! command -v "$BROWSER" >/dev/null 2>&1; then
  printf '%s\n' "ERROR: $BROWSER is not installed (the page needs WebGPU + WASM JSPI: Chrome/Edge 137+)." >&2
  exit 1
fi

mkdir -p "$PROFILE"

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_daytona2_web_main_output }}" }))'); s.recv(256); s.close()
PY

server_pid=""
cleanup() {
  if [ -n "$server_pid" ]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM HUP

# Reuse a server left behind by an earlier run; otherwise start one for this
# session and stop it when the window closes.
if ! curl -fsS -o /dev/null "$BASE/" 2>/dev/null; then
  python3 -m http.server "$PORT" --bind 127.0.0.1 --directory "$ROOT" >/dev/null 2>&1 &
  server_pid=$!
  i=0
  while [ "$i" -lt 100 ]; do
    if curl -fsS -o /dev/null "$BASE/" 2>/dev/null; then break; fi
    sleep 0.1
    i=$((i + 1))
  done
  if ! curl -fsS -o /dev/null "$BASE/" 2>/dev/null; then
    printf '%s\n' "ERROR: the local server on $BASE did not start." >&2
    exit 1
  fi
fi

# X11 through Xwayland on purpose: Chromium's Wayland backend rejects Vulkan
# here ("--ozone-platform=wayland is not compatible with Vulkan") and the
# page's WebGPU device is lost right after the first frame. With Vulkan
# compositing the compositor and Dawn share one instance and the cabinet runs
# at 60 fps. No --enable-unsafe-webgpu: WebGPU is enabled by default in
# current Chromium, and that flag only adds Chrome's unsupported-flag banner.
set +e
"$BROWSER" \
  --app="$URL" \
  --class=daytona2-web \
  --user-data-dir="$PROFILE" \
  --ozone-platform=x11 \
  --enable-features=Vulkan \
  --use-angle=vulkan \
  --ignore-gpu-blocklist \
  --start-fullscreen \
  --no-first-run \
  --no-default-browser-check \
  --password-store=basic \
  --disable-component-update \
  --disable-session-crashed-bubble \
  >/dev/null 2>&1
rc=$?
set -e

exit "$rc"