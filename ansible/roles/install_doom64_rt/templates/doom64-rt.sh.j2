#!/usr/bin/env sh
set -eu
# Doom 64 RT launcher — native Linux AppImage (gzdoom-rt + RTGL1 path tracing)
# on the RTX 5090. Managed by install_doom64_rt.

APPIMAGE="{{ dg_d64rt_install_dir }}/{{ dg_d64rt_appimage_name }}"
if [ ! -f "$APPIMAGE" ]; then
  printf '%s\n' "ERROR: Doom 64 RT not installed ($APPIMAGE)." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-doom64-rt.yml" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_d64rt_main_output }}" }))'); s.recv(256); s.close()
PY

export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/nvidia_icd.json}"

cd "{{ dg_d64rt_install_dir }}"
# No /dev/fuse in the migrated gaming container: let the AppImage runtime
# extract and run itself instead of mounting the image.
export APPIMAGE_EXTRACT_AND_RUN=1
exec "$APPIMAGE" "$@"
