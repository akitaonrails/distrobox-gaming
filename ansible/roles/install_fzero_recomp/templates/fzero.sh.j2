#!/bin/sh
# F-Zero Forever launcher — native Linux build of RetroPortingToolKit's SNES
# F-Zero recomp, on DP-1. 8BitDo native via SDL. Managed by install_fzero_recomp.
#
# The ROM is passed as the first positional argument and config.ini seeds
# SkipLauncher=1, so the game boots straight in with no GUI picker. The host
# verifies the dump's sha256 itself and auto-strips a 512-byte copier header.
set -eu

BIN="{{ dg_fzero_bin }}"
ROM="{{ dg_fzero_rom }}"
if [ ! -x "$BIN" ]; then
  printf '%s\n' "ERROR: F-Zero Forever missing at $BIN." >&2
  printf '%s\n' "Run: cd {{ dg_project_root }}/ansible && ansible-playbook install-fzero-recomp.yml" >&2
  exit 1
fi
if [ ! -f "$ROM" ]; then
  printf '%s\n' "ERROR: F-Zero (USA) ROM missing at $ROM" >&2
  exit 1
fi

# Focus the main landscape 4K monitor (Hyprland >= 0.56 Lua IPC form).
python3 - <<'PY' 2>/dev/null || true
import socket, os, glob
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1026")
paths = [f"{xdg}/hypr/{sig}/.socket.sock"] if sig else glob.glob(f"{xdg}/hypr/*/.socket.sock")
if paths:
    s = socket.socket(socket.AF_UNIX); s.connect(paths[0])
    s.sendall(b'eval hl.dispatch(hl.dsp.focus({ monitor = "{{ dg_fzero_main_output }}" }))'); s.recv(256); s.close()
PY

# The OpenGL/HD Mode 7 path renders on the RTX (not the AMD iGPU).
export __NV_PRIME_RENDER_OFFLOAD="${__NV_PRIME_RENDER_OFFLOAD:-1}"
export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
export SDL_JOYSTICK_HIDAPI_STEAM=1
export SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD=1

# config.ini, fzero-video.ini and saves/ are relative to the working directory.
cd "{{ dg_fzero_root }}"
exec "$BIN" "$ROM" "$@"