# Runtime settings for pgr4.exe (seeded by install_pgr4_recomp).
# Maxed-out 4K baseline for RTX 5090 (1280x720 x 3 = 3840x2160 native, 4x MSAA,
# 16x AF, XeGTAO, enhanced reflections, HD textures, unlocked FPS + VSync).
# PGR4Launcher.exe and in-game menus can change these; later runs keep edits.

pgr4_settings_version = 10
pgr4_native = true
pgr4_native_primary = true
pgr4_60fps = true
pgr4_native_frame_latency = 3
pgr4_render_height = 0
pgr4_native_anisotropy = 16
pgr4_native_resolution_scale = 3
pgr4_native_msaa = 4
pgr4_native_upscaler = false
pgr4_native_dlss = true
pgr4_native_dlss_fg = false
pgr4_native_dlss_mode = "dlaa"
pgr4_native_fsr_mode = "dlaa"
pgr4_native_dlss_preset = "E"
pgr4_native_dlss_jitter_sign = 1
pgr4_native_dlss_fg_mvec_x = 1
pgr4_native_dlss_fg_mvec_y = 1
pgr4_native_dlss_fg_frames = 1
pgr4_native_gpu_serialize_fg = false
pgr4_native_frame_generation = false
pgr4_native_upscaler_width = 1280
pgr4_native_upscaler_height = 720
pgr4_native_upscaler_target_fps = 0
pgr4_native_upscaler_min_height = 360
pgr4_native_sharpen_dlss = 0.150000
pgr4_native_sharpen_fsr = 0.150000
pgr4_native_gtao = true
pgr4_native_texture_hd = true
pgr4_native_enhanced_reflections = true
pgr4_native_details = 2
pgr4_native_brightness = 100
pgr4_native_present_interval = 1
pgr4_native_fps_limit = 0
pgr4_free_camera = true
bind_screenshot = ""
bind_overlay = ""
bind_renderer_switch = ""
bind_achievements = ""
bind_upscaler = ""
bind_upscaler_debug = ""
bind_debug_overlay = ""
bind_settings = ""

gpu_plugin = "xenos"
execute_unclipped_draw_vs_on_cpu = true
d3d12_present_vsync = true
gpu_vblank_deadline_timer = true
gpu_wait_reg_mem_high_res = true
clear_memory_page_state = false
gpu_ring_wake_fast = true
texture_cache_memory_limit_soft_lifetime = 30
guest_frame_stats = true

pgr4_disable_motion_blur = false
pgr4_disable_hdr = false
pgr4_first_launch_done = true

fullscreen = true
fullscreen_exclusive = false
fullscreen_resolution = ""

pgr4_camera_shake_scale = 1.0
pgr4_cockpit_body_follow = true
pgr4_steady_body_pose = true

game_data_root = 'game'
update_data_root = 'title-update'
content_root = ''
dlc_root = ''
