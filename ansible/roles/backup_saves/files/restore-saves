#!/usr/bin/env sh
# restore-saves — pull emulator + PC-port save data back from the NAS backup.
#
# The counterpart to backup-saves. Reads the same manifest and rsyncs each
# $DG_BACKUP_ROOT/<name>/ back to its box location. Intended for a from-scratch
# distrobox remount: run it once after `ansible-playbook site.yml`.
#
# SAFE BY DEFAULT: uses --ignore-existing, so a save already present on the box
# is never overwritten (a fresh box gets everything; an existing box only gains
# what it's missing). Flags:
#   --update    replace a local save only if the backup copy is NEWER
#   --force     overwrite local saves with the backup unconditionally
#   --dry-run   show what would change
#
#   distrobox enter gaming -- restore-saves
#   distrobox enter gaming -- restore-saves --dry-run
#
# Managed by the distrobox-gaming backup_saves role.
set -eu

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/distrobox-gaming"
[ -f "$CONF_DIR/backup.env" ] && . "$CONF_DIR/backup.env"
MANIFEST="${DG_SAVE_MANIFEST:-$CONF_DIR/save-manifest.tsv}"
: "${DG_BACKUP_ROOT:?DG_BACKUP_ROOT not set (rendered into $CONF_DIR/backup.env by the backup_saves role)}"
[ -f "$MANIFEST" ] || { echo "restore-saves: no manifest at $MANIFEST" >&2; exit 1; }

MODE="--ignore-existing"   # default: never clobber a save already on the box
DRY=""
for a in "$@"; do
  case "$a" in
    --force)   MODE="" ;;
    --update)  MODE="--update" ;;
    --dry-run) DRY="--dry-run" ;;
    *) echo "restore-saves: unknown option $a" >&2; exit 2 ;;
  esac
done

[ -d "$DG_BACKUP_ROOT" ] || { echo "restore-saves: no backup at $DG_BACKUP_ROOT" >&2; exit 1; }

TAB="$(printf '\t')"
n=0; restored=0; absent=0
while IFS="$TAB" read -r name rel; do
  case "$name" in ''|\#*) continue ;; esac
  n=$((n + 1))
  bak="$DG_BACKUP_ROOT/$name"
  if [ ! -d "$bak" ]; then
    absent=$((absent + 1)); printf '  –  %s (nothing in backup)\n' "$name"; continue
  fi
  dst="$HOME/$rel"
  mkdir -p "$dst"
  rsync -a $MODE $DRY "$bak/" "$dst/"
  restored=$((restored + 1)); printf '  \342\234\223  %s\n' "$name"
done < "$MANIFEST"

echo "restore-saves: $restored restored, $absent absent (of $n sets)${DRY:+  [dry-run]}${MODE:+  [${MODE#--}]}"
